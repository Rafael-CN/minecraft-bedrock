# ============================================================
#  Configuração do servidor Minecraft Bedrock (.env.example)
#  Copie para ".env", ajuste os caminhos e use ".\scripts\mc.ps1 up"
# ============================================================

# LATEST = sempre a versão estável mais nova (ou fixe ex.: 1.26.45.01)
VERSION=LATEST
IMAGE_TAG=latest

SERVER_NAME=Minecraft Bedrock Server

# Nome da pasta do mundo dentro de data/worlds/
LEVEL_NAME=Bedrock level
LEVEL_SEED=

GAMEMODE=survival
DIFFICULTY=normal
ALLOW_CHEATS=false
MAX_PLAYERS=10

ONLINE_MODE=true
ALLOW_LIST=false
# Gamertags separadas por vírgula (ex.: Jogador1,Jogador2)
ALLOW_LIST_USERS=

# Operadores (admin), separados por vírgula
OPS=
DEFAULT_PLAYER_PERMISSION_LEVEL=member

VIEW_DISTANCE=14
TICK_DISTANCE=4

# Limite de recursos do container principal
CPUS=4
MEM_LIMIT=6g

# ---------------------------------------------------------------
#  Armazenamento do mundo (recomendado em filesystem Linux/WSL2)
# ---------------------------------------------------------------
DATA_PATH=/home/seu-usuario/minecraft-bedrock/data
DATA_UNC=\\wsl.localhost\Ubuntu\home\seu-usuario\minecraft-bedrock\data

# Retenção automática de backups
BACKUP_KEEP=7

# Portas UDP expostas no host
HOST_PORT=19132
HOST_PORT_V6=19133

# ---------------------------------------------------------------
#  Bancada de testes (.\scripts\mc.ps1 teste up)
# ---------------------------------------------------------------
TESTE_PORT=19134
TESTE_LEVEL=Bancada
TESTE_CPUS=2
TESTE_MEM=3g
TESTE_DATA_PATH=/home/seu-usuario/minecraft-bedrock/data-teste
TESTE_DATA_UNC=\\wsl.localhost\Ubuntu\home\seu-usuario\minecraft-bedrock\data-teste

# ---------------------------------------------------------------
#  Backup a quente e autoheal
# ---------------------------------------------------------------
BACKUP_CRON=0 5 * * *
BACKUP_ON_START=false
BACKUPS_PATH=/home/seu-usuario/minecraft-bedrock/backups
BACKUPS_UNC=\\wsl.localhost\Ubuntu\home\seu-usuario\minecraft-bedrock\backups

# Painel de controle local (127.0.0.1)
PANEL_PORT=8080

# Renderizador e servidor de mapa local (127.0.0.1)
MAP_PORT=8081
MAP_CRON=30 5 * * *
MAP_ON_START=true
MAP_ZOOM_IN=3
MAP_ZOOM_OUT_LEVELS=6
